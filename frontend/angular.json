{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "railway": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "rw",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "tsConfig": "tsconfig.app.json",
            "index": "src/index.html", "styles": ["src/styles.css", "src/theme.css"],
            "assets": [{"glob": "**/*", "input": "public"}],
            "outputPath": "dist/railway"
          },
          "configurations": {
            "production": {"outputHashing": "all", "budgets": [{"type":"initial","maximumWarning":"650kB","maximumError":"900kB"}]},
            "development": {"optimization": false, "sourceMap": true, "extractLicenses": false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"proxyConfig": "proxy.conf.json"},
          "configurations": {"development": {"buildTarget": "railway:build:development"},"production": {"buildTarget": "railway:build:production"}},
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
